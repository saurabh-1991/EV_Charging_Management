rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(myUid())).data;
    }

    function isAdmin() {
      return signedIn() &&
          exists(/databases/$(database)/documents/users/$(myUid())) &&
          myUser().role == 'admin' &&
          myUser().status == 'active';
    }

    function isActiveUser() {
      return signedIn() &&
          (!exists(/databases/$(database)/documents/users/$(myUid())) ||
              myUser().status != 'disabled');
    }

    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(myUid()));
    }

    function myFlatKey() {
      return myUser().wing + '|' + myUser().flatNumber;
    }

    function sameFlatByPointWing() {
      return hasProfile() &&
          resource.data.wing == myUser().wing &&
          resource.data.flatNumber == myUser().flatNumber;
    }

    function sameFlatByBillingWing() {
      return hasProfile() &&
          resource.data.billingWing == myUser().wing &&
          resource.data.flatNumber == myUser().flatNumber;
    }

    function sameFlatPayment() {
      return hasProfile() &&
          resource.data.billingFlatKey == myFlatKey();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && myUid() == userId);
      allow create: if signedIn() &&
          myUid() == userId &&
          request.resource.data.role == 'resident' &&
          request.resource.data.status in ['active', 'pending'];
      allow update: if isAdmin() ||
          (signedIn() &&
              myUid() == userId &&
              request.resource.data.role == resource.data.role &&
              request.resource.data.status == resource.data.status);
      allow delete: if false;
    }

    match /appConfig/{docId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /chargingSlots/{slotId} {
      allow read: if isActiveUser();
      allow write: if isAdmin() || isActiveUser();
    }

    match /chargingSessions/{sessionId} {
      allow read: if isAdmin() ||
          (isActiveUser() && resource.data.ownerUid == myUid()) ||
          (isActiveUser() && sameFlatByPointWing()) ||
          (isActiveUser() && sameFlatByBillingWing());
      allow create: if isActiveUser() &&
          request.resource.data.ownerUid == myUid();
      allow update: if isAdmin() ||
          (isActiveUser() && resource.data.ownerUid == myUid());
      allow delete: if false;
    }

    match /vehicles/{vehicleId} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser();
      allow delete: if false;
    }

    match /slotBookings/{bookingId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() &&
          request.resource.data.ownerUid == myUid();
      allow update: if isAdmin() ||
          (isActiveUser() && resource.data.ownerUid == myUid()) ||
          (isActiveUser() &&
              resource.data.status == 'booked' &&
              request.resource.data.status in ['overridden', 'used'] &&
              request.resource.data.ownerUid == resource.data.ownerUid &&
              (
                (request.resource.data.status == 'used' &&
                    request.resource.data.ownerUid == myUid()) ||
                (request.resource.data.status == 'overridden' &&
                    request.resource.data.overriddenByUid == myUid())
              ));
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() ||
          (isActiveUser() && resource.data.ownerUid == myUid()) ||
          (isActiveUser() && sameFlatPayment());
      allow create: if isActiveUser() &&
          request.resource.data.ownerUid == myUid() &&
          (
            !('billingFlatKey' in request.resource.data) ||
            request.resource.data.billingFlatKey == myFlatKey()
          );
      allow update: if isAdmin() ||
          (isActiveUser() &&
              resource.data.ownerUid == myUid() &&
              request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['wing', 'flatNumber', 'billingFlatKey']) &&
              request.resource.data.billingFlatKey == myFlatKey() &&
              request.resource.data.wing == myUser().wing &&
              request.resource.data.flatNumber == myUser().flatNumber &&
              (
                !('billingFlatKey' in resource.data) ||
                resource.data.billingFlatKey == '' ||
                resource.data.billingFlatKey == myFlatKey()
              ));
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
